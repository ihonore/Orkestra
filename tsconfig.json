{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is here for code inside page.evaluate(), which runs in the browser,
    // not in Node. That does mean `document` and `window` typecheck everywhere,
    // so eslint's no-restricted-globals forbids them by default — each genuine
    // browser-side callback disables it explicitly, which keeps every crossing
    // of the Node/browser boundary visible and greppable.
    // DOM.Iterable too, so a NodeList can be spread inside evaluate callbacks.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
