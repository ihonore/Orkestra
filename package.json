{
  "name": "gms",
  "version": "0.1.0",
  "private": true,
  "description": "Modular web automation platform. Google Maps lead extraction is the first automation.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "bin": {
    "gms": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "seeds"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gms": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm run test",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli/main.js', 0o755)\""
  },
  "dependencies": {
    "@googleapis/sheets": "^14.0.0",
    "better-sqlite3": "^13.0.2",
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "read-excel-file": "^9.3.5",
    "tldts": "^7.4.10",
    "undici": "^8.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
